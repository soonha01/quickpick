<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>채팅</title>

  <!-- 폰트 및 기본 CSS 로딩 -->
  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/css/sb-admin-2.min.css" rel="stylesheet">

  <style>
    /* Pretendard 폰트 적용 */
    @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');

    /* 전체 배경 및 폰트 스타일 */
    body {
      background: linear-gradient(to right, #9cc4e4, #cfe9ff);
      font-family: 'Pretendard', 'Helvetica Neue', sans-serif;
      color: #2a3b4c;
    }

    /* 채팅 전체 레이아웃 */
    .chat-container {
      display: flex;
      height: 90vh;
      background-color: #eef6fb;
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    /* 채팅방 목록 영역 */
    .chat-sidebar {
      width: 22%;
      background: linear-gradient(180deg, #bddcf3, #a4c8e4);
      padding: 1.4rem 1rem;
      border-right: 1px solid #aacce4;
      overflow-y: auto;
    }

    /* 채팅방 목록 아이템 스타일 */
    .chat-room-item {
      padding: 13px 15px;
      background-color: #d8eaf7;
      border-radius: 12px;
      margin-bottom: 12px;
      font-size: 0.95rem;
      font-weight: 500;
      color: #2a3b4c;
      border: 1px solid #b1d2eb;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
      transition: all 0.2s ease;
    }

    .chat-room-item:hover {
      background-color: #c9e0f0;
      transform: translateY(-1px);
      cursor: pointer;
    }

    /* 채팅 메시지 영역 */
    .chat-main {
      width: 78%;
      display: flex;
      flex-direction: column;
      padding: 1.4rem 2rem;
      background-color: #f3fbff;
    }

    /* 채팅방 제목 스타일 */
    #chatRoomTitle {
      font-size: 1.25rem;
      font-weight: 600;
      padding: 0.6rem 1.2rem;
      background: linear-gradient(135deg, #56bfff, #4db8ff);
      color: white;
      border-radius: 12px;
      margin-bottom: 1rem;
      display: inline-block;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* 채팅 메시지 박스 스타일 */
    .chat-messages {
      flex-grow: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      padding: 1rem;
    }

    /* 말풍선 애니메이션 */
    .chat-wrapper {
      display: flex;
      flex-direction: column;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* 채팅 말풍선 좌우 정렬 */
    .chat-left-wrapper { align-items: flex-start; margin-right: auto; }
    .chat-right-wrapper { align-items: flex-end; margin-left: auto; }

    .chat-bubble {
      max-width: 100%;
      padding: 0.8rem 1rem;
      border-radius: 16px;
      font-size: 0.94rem;
      word-break: break-word;
      white-space: pre-wrap;
      position: relative;
      line-height: 1.45;
    }

    .chat-left { background-color: #b4d8f0; color: #1a1a1a; }
    .chat-right { background-color: #4db8ff; color: white; }

    .chat-meta {
      font-size: 0.75rem;
      color: #688fa8;
      margin-bottom: 4px;
    }

    /* 입력창과 전송버튼 스타일 */
    .chat-input-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1.2rem;
      padding: 0.6rem 1rem;
      border-top: 1px solid #aacce4;
      background-color: #d6eafa;
      border-radius: 12px;
    }

    #messageInput {
      flex-grow: 1;
      border: 1px solid #aacce4;
      border-radius: 20px;
      padding: 0.75rem 1rem;
      background-color: #eef6fb;
      color: #2a3b4c;
      font-size: 0.95rem;
    }

    #messageInput::placeholder { color: #888; }

    #sendMessage {
      background: linear-gradient(135deg, #4db8ff, #369de3);
      color: white;
      padding: 0.7rem 1.4rem;
      border: none;
      border-radius: 20px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
      line-height: 1;
      min-width: 64px;
    }

    #sendMessage:hover {
      background: linear-gradient(135deg, #369de3, #4db8ff);
      transform: scale(1.05);
    }

    /* 채팅방 제목 없을 경우 숨김 */
    #chatRoomTitle:empty { display: none !important; }
  </style>

  <!-- 서버에서 넘긴 사용자 정보 (EJS 변수 → JS 변수로 저장) -->
  <script>
    const userKey = <%= userKey %>;
    const userName = "<%= userName %>";
  </script>
</head>


<body id="page-top">
  <!-- 전체 페이지 래퍼 -->
  <div id="wrapper">
    <!-- 왼쪽 사이드바가 동적으로 삽입될 자리 -->
    <div id="sidebar-container"></div>

    <!-- 메인 콘텐츠 영역 -->
    <div id="content-wrapper" class="d-flex flex-column">
      <div id="content">
        <!-- 상단 네비게이션 바 삽입 자리 -->
        <div id="topbar-container"></div>

        <!-- 페이지 내용 -->
        <div class="container-fluid">
          <div class="chat-container">
            <!-- 채팅방 목록 영역 -->
            <div class="chat-sidebar">
              <div id="roomList"></div> <!-- 채팅방 목록이 여기에 동적 생성됨 -->
            </div>

            <!-- 채팅 메시지 영역 -->
            <div class="chat-main">
              <h4 id="chatRoomTitle"></h4> <!-- 채팅방 제목 표시 -->
              <div id="messages" class="chat-messages"></div> <!-- 채팅 메시지 표시 영역 -->

              <!-- 메시지 입력창 및 전송버튼 -->
              <div class="chat-input-group">
                <input type="text" id="messageInput" placeholder="메시지를 입력하세요">
                <button id="sendMessage">전송</button>
              </div>
            </div>
          </div>
        </div>

        <!-- 하단 푸터 삽입 영역 -->
        <div id="footer-container"></div>
      </div>
    </div>
  </div>

  <!-- 외부 스크립트들 로딩 -->
  <script src="/js/includeAndSession.js"></script>
  <script src="/vendor/jquery/jquery.min.js"></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>
  <script src="/js/sb-admin-2.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>

  <!-- 채팅 로직 -->
  <script>
    const socket = io(); // 소켓 연결
    let currentRoomId = null; // 현재 입장 중인 채팅방 ID

    // 현재 시간을 KST 기준 ISO 포맷 문자열로 반환
    function getKSTISOString() {
      const now = new Date();
      const kst = new Date(now.getTime() + 9 * 60 * 60 * 1000);
      return kst.toISOString().slice(0, 19).replace('T', ' ');
    }

    // 채팅방 목록 로드 및 클릭 시 동작 정의
    function loadRooms() {
      fetch(`/chat/rooms`)
        .then(res => res.json())
        .then(rooms => {
          const list = document.getElementById('roomList');
          list.innerHTML = ''; // 기존 목록 비움

          rooms.forEach(room => {
            const item = document.createElement('div');
            item.className = 'chat-room-item';
            item.textContent = `${room.title}`;

            // 채팅방 클릭 시 입장 및 메시지 로드
            item.onclick = () => {
              if (currentRoomId) socket.emit('leaveRoom', currentRoomId); // 기존 방 나가기
              currentRoomId = room.chat_key;
              socket.emit('joinRoom', currentRoomId); // 새 방 입장

              document.getElementById('chatRoomTitle').textContent = `${room.title}`;
              document.getElementById('messages').innerHTML = ''; // 채팅창 초기화

              // 기존 메시지 로드
              fetch(`/chat/messages/${room.chat_key}`)
                .then(res => res.json())
                .then(messages => {
                  messages.forEach(msg => {
                    if (msg.chat_content?.trim()) {
                      const isMine = msg.display_name === userName;
                      drawMessage(isMine, msg.chat_content, msg.display_name, msg.send_time);
                    }
                  });
                });
            };
            list.appendChild(item);
          });
        });
    }

    // 채팅 메시지를 화면에 출력
    function drawMessage(isMine, content, name, time) {
      const messageBox = document.getElementById('messages');

      // 타이핑 알림 제거
      const notice = document.getElementById('typingNotice');
      if (notice) notice.remove();

      // 말풍선 요소 생성
      const wrapper = document.createElement('div');
      wrapper.className = 'chat-wrapper ' + (isMine ? 'chat-right-wrapper' : 'chat-left-wrapper');

      const meta = document.createElement('div');
      meta.className = 'chat-meta';
      meta.textContent = `[${time}] ${name}`;

      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble ' + (isMine ? 'chat-right' : 'chat-left');
      bubble.textContent = content;

      // 요소 추가 및 스크롤 맨 아래로
      wrapper.appendChild(meta);
      wrapper.appendChild(bubble);
      messageBox.appendChild(wrapper);
      messageBox.scrollTop = messageBox.scrollHeight;
    }

    // 메시지 전송 처리
    function sendMessage() {
      const input = document.getElementById('messageInput');
      const message = input.value.trim();
      if (!message || !currentRoomId) return;

      // 현재 시간 포맷
      const time = new Date().toLocaleString('ko-KR', {
        timeZone: 'Asia/Seoul',
        year: 'numeric', month: 'numeric', day: 'numeric',
        hour: 'numeric', minute: 'numeric', second: 'numeric',
        hour12: true
      });

      // 소켓으로 메시지 전송
      socket.emit('chatMessage', {
        chatRoomId: currentRoomId,
        userName: String(userName),
        message
      });

      // 본인 메시지 화면에 표시
      drawMessage(true, message, userName, time);

      // DB에 저장
      fetch('/chat/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_key: userKey,
          chat_key: currentRoomId,
          chat_content: message,
          created_at: getKSTISOString()
        })
      }).then(() => {
        input.value = ''; // 전송 후 입력창 비움
      });
    }

    // 버튼 클릭 및 Enter 키로 메시지 전송
    document.getElementById('sendMessage').addEventListener('click', sendMessage);
    document.getElementById('messageInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') sendMessage();
    });

    // 입력 중이면 타이핑 알림 보내기
    document.getElementById('messageInput').addEventListener('input', () => {
      const inputValue = document.getElementById('messageInput').value;
      if (!currentRoomId || !userName) return;

      if (inputValue.length === 0) {
        socket.emit('stopTyping', { chatRoomId: currentRoomId, userName });
      } else {
        socket.emit('typing', { chatRoomId: currentRoomId, userName });
      }
    });

    // 상대방의 입력 중 알림 표시
    let typingTimer = null;
    socket.on('typing', (name) => {
      if (name === userName) return;

      const messageBox = document.getElementById('messages');
      let notice = document.getElementById('typingNotice');
      if (!notice) {
        notice = document.createElement('div');
        notice.id = 'typingNotice';
        notice.textContent = `💬 ${name}님이 입력 중입니다...`;
        notice.style.backgroundColor = '#eaf4ff';
        notice.style.color = '#357abd';
        notice.style.padding = '6px 12px';
        notice.style.margin = '4px 10px';
        notice.style.borderRadius = '8px';
        notice.style.fontWeight = '500';
        notice.style.fontSize = '0.85rem';
        notice.style.fontStyle = 'italic';
        notice.style.boxShadow = '0 1px 3px rgba(0, 0, 0, 0.05)';
        notice.style.alignSelf = 'flex-start';
        notice.style.transition = 'all 0.2s ease';
        messageBox.appendChild(notice);
      }

      messageBox.scrollTop = messageBox.scrollHeight;
    });

    // 상대방 입력 멈춤 알림 제거
    socket.on('stopTyping', (name) => {
      if (name === userName) return;
      const el = document.getElementById('typingNotice');
      if (el) el.remove();
    });

    // 서버에서 수신된 메시지 출력
    socket.on('chatMessage', (data) => {
      if (data.userName === userName) return; // 내 메시지는 이미 출력했음
      const now = new Date().toLocaleString('ko-KR', {
        timeZone: 'Asia/Seoul',
        year: 'numeric', month: 'numeric', day: 'numeric',
        hour: 'numeric', minute: 'numeric', second: 'numeric',
        hour12: true
      });
      drawMessage(false, data.message, data.userName, now);
    });

    // 페이지 진입 시 채팅방 목록 불러오기
    loadRooms();
  </script>
</body>
</html>
