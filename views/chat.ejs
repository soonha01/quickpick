<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>채팅</title>
  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/css/sb-admin-2.min.css" rel="stylesheet">
  <style>
    .chat-container {
      display: flex;
      height: 600px;
      border: 1px solid #ccc;
      border-radius: 10px;
      overflow: hidden;
    }
    .chat-sidebar {
      width: 30%;
      border-right: 1px solid #ddd;
      background-color: #f8f9fc;
      padding: 1rem;
      overflow-y: auto;
    }
    .chat-main {
      width: 50%;
      display: flex;
      flex-direction: column;
      padding: 1rem;
      margin-left: auto;
    }
    .chat-messages {
      flex-grow: 1;
      border: 1px solid #ddd;
      border-radius: 10px;
      padding: 1rem;
      overflow-y: auto;
      margin-bottom: 1rem;
      background-color: white;
    }
    .chat-input-group {
      display: flex;
      gap: 0.5rem;
    }
    .chat-room-item {
      padding: 10px;
      border-radius: 5px;
      background-color: white;
      margin-bottom: 5px;
      cursor: pointer;
    }
    .chat-room-item:hover {
      background-color: #e2e6ea;
    }
    .chat-filters {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    #sendMessage {
      font-size: 0.8rem !important;
      padding: 0.4rem 0.6rem;
    }
  </style>

  <!-- 사용자 정보 삽입 -->
  <script>
    const userKey = <%= userKey %>;
    const userName = "<%= userName %>";
  </script>

</head>

<body id="page-top">
  <div id="wrapper">
    <div id="sidebar-container"></div>
    <div id="content-wrapper" class="d-flex flex-column">
      <div id="content">
        <div id="topbar-container"></div>
        <div class="container-fluid">

          <div class="chat-filters">
            <button class="btn btn-outline-secondary btn-sm" id="filter-all">전체</button>
            <button class="btn btn-outline-primary btn-sm" id="filter-bid">낙찰</button>
            <button class="btn btn-outline-success btn-sm" id="filter-done">거래완료</button>
          </div>

          <div class="chat-container">
            <div class="chat-sidebar">
              <div id="roomList"></div>
            </div>
            <div class="chat-main">
              <div id="messages" class="chat-messages"></div>
              <div class="chat-input-group">
                <input type="text" id="messageInput" class="form-control" placeholder="메시지를 입력하세요">
                <button class="btn btn-primary" id="sendMessage">전송</button>
              </div>
            </div>
          </div>
        </div>
        <div id="footer-container"></div>
      </div>
    </div>
  </div>

  <a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>

  <script src="/js/includeAndSession.js"></script>
  <script src="/vendor/jquery/jquery.min.js"></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>
  <script src="/js/sb-admin-2.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
