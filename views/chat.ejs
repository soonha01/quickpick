<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <title>채팅</title>
  <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
  <link href="/css/sb-admin-2.min.css" rel="stylesheet">
  <style>
    @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');

    body {
      background: linear-gradient(to right, #9cc4e4, #cfe9ff);
      font-family: 'Pretendard', 'Helvetica Neue', sans-serif;
      color: #2a3b4c;
    }

    .chat-container {
      display: flex;
      height: 90vh;
      background-color: #eef6fb;
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .chat-sidebar {
      width: 22%;
      background: linear-gradient(180deg, #bddcf3, #a4c8e4);
      padding: 1.4rem 1rem;
      border-right: 1px solid #aacce4;
      overflow-y: auto;
    }

    .chat-room-item {
      padding: 13px 15px;
      background-color: #d8eaf7;
      border-radius: 12px;
      margin-bottom: 12px;
      font-size: 0.95rem;
      font-weight: 500;
      color: #2a3b4c;
      border: 1px solid #b1d2eb;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
      transition: all 0.2s ease;
    }

    .chat-room-item:hover {
      background-color: #c9e0f0;
      transform: translateY(-1px);
      cursor: pointer;
    }

    .chat-main {
      width: 78%;
      display: flex;
      flex-direction: column;
      padding: 1.4rem 2rem;
      background-color: #f3fbff;
    }

    #chatRoomTitle {
      font-size: 1.25rem;
      font-weight: 600;
      padding: 0.6rem 1.2rem;
      background: linear-gradient(135deg, #56bfff, #4db8ff);
      color: white;
      border-radius: 12px;
      margin-bottom: 1rem;
      display: inline-block;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .chat-messages {
      flex-grow: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      padding: 1rem;
    }

    .chat-wrapper {
      display: flex;
      flex-direction: column;
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .chat-left-wrapper {
      align-items: flex-start;
      margin-right: auto;
    }

    .chat-right-wrapper {
      align-items: flex-end;
      margin-left: auto;
    }

    .chat-bubble {
      max-width: 100%;
      padding: 0.8rem 1rem;
      border-radius: 16px;
      font-size: 0.94rem;
      word-break: break-word;
      white-space: pre-wrap;
      position: relative;
      line-height: 1.45;
    }

    .chat-left {
      background-color: #b4d8f0;
      color: #1a1a1a;
    }

    .chat-right {
      background-color: #4db8ff;
      color: white;
    }

    .chat-meta {
      font-size: 0.75rem;
      color: #688fa8;
      margin-bottom: 4px;
    }

    .chat-input-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1.2rem;
      padding: 0.6rem 1rem;
      border-top: 1px solid #aacce4;
      background-color: #d6eafa;
      border-radius: 12px;
    }

    #messageInput {
      flex-grow: 1;
      border: 1px solid #aacce4;
      border-radius: 20px;
      padding: 0.75rem 1rem;
      background-color: #eef6fb;
      color: #2a3b4c;
      font-size: 0.95rem;
    }

    #messageInput::placeholder {
      color: #888;
    }

    #sendMessage {
      background: linear-gradient(135deg, #4db8ff, #369de3);
      color: white;
      padding: 0.7rem 1.4rem;
      border: none;
      border-radius: 20px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
      line-height: 1;
      min-width: 64px;
    }

    #sendMessage:hover {
      background: linear-gradient(135deg, #369de3, #4db8ff);
      transform: scale(1.05);
    }

    #chatRoomTitle:empty {
      display: none !important;
    }
  </style>

  <script>
    const userKey = <%= userKey %>;
    const userName = "<%= userName %>";
  </script>
</head>

<body id="page-top">
  <div id="wrapper">
    <div id="sidebar-container"></div>
    <div id="content-wrapper" class="d-flex flex-column">
      <div id="content">
        <div id="topbar-container"></div>
        <div class="container-fluid">
          <div class="chat-container">
            <div class="chat-sidebar">
              <div id="roomList"></div>
            </div>
            <div class="chat-main">
              <h4 id="chatRoomTitle"></h4>
              <div id="messages" class="chat-messages"></div>
              <div class="chat-input-group">
                <input type="text" id="messageInput" placeholder="메시지를 입력하세요">
                <button id="sendMessage">전송</button>
              </div>
            </div>
          </div>
        </div>
        <div id="footer-container"></div>
      </div>
    </div>
  </div>

  <script src="/js/includeAndSession.js"></script>
  <script src="/vendor/jquery/jquery.min.js"></script>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>
  <script src="/js/sb-admin-2.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    let currentRoomId = null;

    function getKSTISOString() {
      const now = new Date();
      const kst = new Date(now.getTime() + 9 * 60 * 60 * 1000);
      return kst.toISOString().slice(0, 19).replace('T', ' ');
    }

    function loadRooms() {
      fetch(`/chat/rooms`)
        .then(res => res.json())
        .then(rooms => {
          const list = document.getElementById('roomList');
          list.innerHTML = '';
          rooms.forEach(room => {
            const item = document.createElement('div');
            item.className = 'chat-room-item';
            item.textContent = `${room.title}`;
            item.onclick = () => {
              if (currentRoomId) socket.emit('leaveRoom', currentRoomId);
              currentRoomId = room.chat_key;
              socket.emit('joinRoom', currentRoomId);

              document.getElementById('chatRoomTitle').textContent = `${room.title}`;
              document.getElementById('messages').innerHTML = '';

              fetch(`/chat/messages/${room.chat_key}`)
                .then(res => res.json())
                .then(messages => {
                  messages.forEach(msg => {
                    if (msg.chat_content?.trim()) {
                      const isMine = msg.display_name === userName;
                      drawMessage(isMine, msg.chat_content, msg.display_name, msg.send_time);
                    }
                  });
                });
            };
            list.appendChild(item);
          });
        });
    }

    function drawMessage(isMine, content, name, time) {
      const messageBox = document.getElementById('messages');

      const notice = document.getElementById('typingNotice');
      if (notice) notice.remove();

      const wrapper = document.createElement('div');
      wrapper.className = 'chat-wrapper ' + (isMine ? 'chat-right-wrapper' : 'chat-left-wrapper');

      const meta = document.createElement('div');
      meta.className = 'chat-meta';
      meta.textContent = `[${time}] ${name}`;

      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble ' + (isMine ? 'chat-right' : 'chat-left');
      bubble.textContent = content;

      wrapper.appendChild(meta);
      wrapper.appendChild(bubble);
      messageBox.appendChild(wrapper);
      messageBox.scrollTop = messageBox.scrollHeight;
    }

    function sendMessage() {
      const input = document.getElementById('messageInput');
      const message = input.value.trim();
      if (!message || !currentRoomId) return;

      const time = new Date().toLocaleString('ko-KR', {
        timeZone: 'Asia/Seoul',
        year: 'numeric', month: 'numeric', day: 'numeric',
        hour: 'numeric', minute: 'numeric', second: 'numeric',
        hour12: true
      });

      socket.emit('chatMessage', {
        chatRoomId: currentRoomId,
        userName: String(userName),
        message
      });

      drawMessage(true, message, userName, time);

      fetch('/chat/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_key: userKey,
          chat_key: currentRoomId,
          chat_content: message,
          created_at: getKSTISOString()
        })
      }).then(() => {
        input.value = '';
      });
    }

        document.getElementById('sendMessage').addEventListener('click', sendMessage);
    document.getElementById('messageInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') sendMessage();
    });

    // 입력 시 타이핑 알림 emit
    document.getElementById('messageInput').addEventListener('input', () => {
      if (currentRoomId && userName) {
        socket.emit('typing', { chatRoomId: currentRoomId, userName });
      }
    });

    // 타이핑 수신 시 출력
    let typingTimer = null;
    socket.on('typing', (name) => {
      if (name === userName) return;

      const messageBox = document.getElementById('messages');
      let notice = document.getElementById('typingNotice');
      if (!notice) {
        notice = document.createElement('div');
        notice.id = 'typingNotice';
        notice.textContent = `${name}님이 입력 중입니다...`;
        notice.style.backgroundColor = '#ffd3d3';
        notice.style.color = '#000';
        notice.style.padding = '10px';
        notice.style.margin = '8px 10px';
        notice.style.borderRadius = '10px';
        notice.style.fontWeight = 'bold';
        notice.style.boxShadow = '0 0 5px rgba(0,0,0,0.2)';
        notice.style.alignSelf = 'flex-start';
        messageBox.appendChild(notice);
      }

      messageBox.scrollTop = messageBox.scrollHeight;

      clearTimeout(typingTimer); // ✅ 기존 타이머 초기화
      typingTimer = setTimeout(() => {
        const el = document.getElementById('typingNotice');
        if (el) el.remove();
      }, 1000); // 1초 동안 새 타이핑이 없으면 제거
    });


    socket.on('chatMessage', (data) => {
      if (data.userName === userName) return;
      const now = new Date().toLocaleString('ko-KR', {
        timeZone: 'Asia/Seoul',
        year: 'numeric', month: 'numeric', day: 'numeric',
        hour: 'numeric', minute: 'numeric', second: 'numeric',
        hour12: true
      });
      drawMessage(false, data.message, data.userName, now);
    });

    loadRooms();
  </script>
</body>
</html>
